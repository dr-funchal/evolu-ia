# Evolu-IA — variáveis de ambiente. NUNCA commitar valores reais.
# Copie para .env e preencha. Gere segredos com: openssl rand -base64 32

# development | test | demo | production
# - demo: dados exclusivamente sintéticos, selo DEMO, troca de persona habilitada.
# - production: rejeita provedores mock, troca de persona e seeds sintéticos (use este em uso real).
APP_MODE=production
APP_BASE_URL=https://evolu-ia.pulpfy.com
APP_TIMEZONE_DEFAULT=America/Sao_Paulo

# PostgreSQL (o compose publica em 127.0.0.1:5442; dentro do compose o host é db:5432)
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=trocar
# Dono do schema; usado apenas por migrations e seed (nunca no caminho de requisição do usuário)
MIGRATION_DATABASE_URL=postgresql://evolu_owner:trocar@localhost:5442/evolu
# Papel da aplicação web: NOSUPERUSER, NOBYPASSRLS, não é dono de tabelas
DATABASE_URL=postgresql://evolu_app:trocar@localhost:5442/evolu
# Papel do worker: NOSUPERUSER, NOBYPASSRLS
WORKER_DATABASE_URL=postgresql://evolu_worker:trocar@localhost:5442/evolu
EVOLU_OWNER_PASSWORD=trocar
EVOLU_APP_PASSWORD=trocar
EVOLU_WORKER_PASSWORD=trocar
ZITADEL_DB_PASSWORD=trocar

# Testes (somente ambiente local/CI; o admin recria o banco de teste)
TEST_ADMIN_DATABASE_URL=postgresql://postgres:trocar@localhost:5442/postgres

# Autenticação OIDC (Zitadel). mock só é aceito em development/test.
AUTH_PROVIDER=oidc
OIDC_ISSUER=https://auth.pulpfy.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Exige MFA no token (claim amr). Em production é sempre exigido.
AUTH_REQUIRE_MFA=true
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=60

# Convites de membros: usuário de serviço do Zitadel (máquina) com ORG_USER_MANAGER na org.
# O PAT cria contas e gera códigos de convite; nunca é exposto ao navegador.
ZITADEL_API_URL=
ZITADEL_SERVICE_PAT=
ZITADEL_ORG_ID=
# link = o admin copia e envia o link; email = o Zitadel envia (exige SMTP configurado no Zitadel)
INVITE_DELIVERY=link

# Arquivos privados (fora do diretório público)
STORAGE_DIR=/data/storage
UPLOAD_MAX_BYTES=10485760

# Zitadel (docker-compose)
ZITADEL_VERSION=v4.19.2
ZITADEL_DOMAIN=auth.pulpfy.com
# Exatamente 32 caracteres
ZITADEL_MASTERKEY=
LOGIN_SESSION_COOKIE_SECRET=
ZITADEL_ADMIN_PASSWORD=
# PAT do usuário de máquina de bootstrap: validade curta; é desativado após scripts/zitadel-bootstrap.sh
ZITADEL_BOOTSTRAP_PAT_EXPIRATION=2026-10-06T00:00:00Z

# IA: none = desligada na plataforma; openrouter = cada equipe informa a própria chave e o modelo
# em Administração → Inteligência artificial. A chave da equipe é cifrada com AI_SECRETS_KEY
# (32 bytes em base64: openssl rand -base64 32). Perder AI_SECRETS_KEY = equipes recadastram a chave.
AI_PROVIDER=openrouter
AI_SECRETS_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
